# Names only; never commit values. Copy to .env and fill in. Unprefixed names win over NWB_* ones.

# ===== Profile ============================================================
APP_ENV=dev                      # dev | test | prod  (sets defaults below; explicit vars still win)
LOG_LEVEL=                       # empty -> DEBUG in dev, INFO otherwise
LOG_FORMAT=                      # empty -> console in dev/test, json in prod
DATAFLOW_TRACE=                  # empty -> on in dev: every hop to var/logs/dataflow.jsonl (never in prod)
NWB_LOG_DIR=var/logs

# ===== LLM (switch provider/model here only) ==============================
# Each role is a comma-separated chain: provider:model,provider:model
# First entry with a key is primary. The rest are LangChain with_fallbacks.
# Hop only on 429, 5xx and timeouts. A provider with no key is skipped (one warning at startup).
# NVIDIA first (no daily request cap; about 40 RPM), then OpenRouter free (50 requests/day).
# Unset LLM_MAIN or LLM_BACKGROUND uses this default. Unset or empty LLM_GRAPH uses the background chain.
# GraphRAG-SDK (LiteLLM) uses the same chain when every provider has a prefix
# (nvidia_nim/, openrouter/, groq/). nvidia_nim reads NVIDIA_NIM_API_KEY, copied from
# NVIDIA_API_KEY at startup when unset. Graphiti uses the same chain via an LLMClient.
LLM_MAIN=nvidia:nvidia/nemotron-3-super-120b-a12b,openrouter:nvidia/nemotron-3-super-120b-a12b:free
LLM_BACKGROUND=nvidia:nvidia/nemotron-3-super-120b-a12b,openrouter:nvidia/nemotron-3-super-120b-a12b:free
LLM_GRAPH=nvidia:nvidia/nemotron-3-super-120b-a12b,openrouter:nvidia/nemotron-3-super-120b-a12b:free
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=0                # OpenAI-compatible clients; 0 = fail over instead of retrying the same host
LLM_REASONING_EFFORT=            # low|medium|high; empty = don't send
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=                 # empty -> http://localhost:11434/v1

# ===== Data ===============================================================
NWB_DATA_DIR=data
NWB_BLOB_DIR=var/blobs
NWB_COMPANY_ID=NW
NWB_GRAPH_NAME=nw
NWB_GRAPH_PREFIX=                # optional prefix on {company}_kb_{level}; empty matches an unprefixed load

# ----- dev (default): local files, nothing to sign up for -----------------
DATABASE_URL=sqlite:///var/nwb.sqlite
FALKORDB_URL=                    # empty -> embedded FalkorDBLite at NWB_FALKOR_LITE_PATH
NWB_FALKOR_LITE_PATH=var/falkor.db

# ----- prod (uncomment; set APP_ENV=prod) ---------------------------------
# Neon Postgres. DATABASE_URL is the app role on the pooled host (sslmode=require).
# NWB_MIGRATE_URL is the owner on the direct host: migrations, checkpoint setup, ingest, cross-user jobs.
# The app role name is nw_app (not the database owner).
# DATABASE_URL=postgresql://nw_app:<password>@<ep-xxx>-pooler.<region>.aws.neon.tech/nwb?sslmode=require
# NWB_MIGRATE_URL=postgresql://<owner>:<password>@<ep-xxx>.<region>.aws.neon.tech/nwb?sslmode=require
# FalkorDB Cloud free tier: plain TCP (no TLS), username + password.
# FALKORDB_URL=redis://<user>:<password>@<host>:<port>
# (or NWB_FALKOR_HOST / NWB_FALKOR_PORT / NWB_FALKOR_USERNAME / NWB_FALKOR_PASSWORD)

# ===== Tokenizer (GraphRAG chunker; populated by `nwb cache-tokenizers`) =====
# TIKTOKEN_CACHE_DIR=          # empty -> config/graph.yaml tokenizer.cache_dir (var/tiktoken)

# ===== Agent runtime (tunables live in config/*.yaml; prompts in prompts/*.md) =====
NWB_CONFIG_DIR=config
NWB_PROMPTS_DIR=prompts
NWB_SKILLS_DIR=skills
NWB_CHECKPOINTER=auto               # auto | memory | sqlite | postgres (auto follows the SQL backend)
NWB_CHECKPOINT_PATH=var/checkpoints.sqlite
NWB_API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
